{
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"name": "@referral-tracking/api",
	"scripts": {
		"lint": "eslint .",
		"start": "tsx src/app.ts",
		"typecheck": "tsc --noEmit",
		"dev": "tsx watch src/app.ts",
		"seed": "tsx script/seed.ts",
		"bootstrap:admin": "tsx script/bootstrap-admin.ts",
		"migrate": "npx drizzle-kit migrate",
		"generate": "npx drizzle-kit generate",
		"purge": "tsx script/purge.ts && rm -rf src/drizzle/migrations",
		"reset": "npx drizzle-kit drop && tsx script/reset.ts && rm -rf src/drizzle/migrations && npx drizzle-kit generate && npx drizzle-kit migrate",
		"clean": "rm -rf node_modules dist src/drizzle/migrations"
	},
	"dependencies": {
		"@fastify/cookie": "11.0.2",
		"@fastify/cors": "11.2.0",
		"@fastify/helmet": "13.0.2",
		"@fastify/rate-limit": "10.3.0",
		"@node-rs/argon2": "2.0.2",
		"@opentelemetry/api": "1.9.1",
		"@referral-tracking/shared": "workspace:*",
		"better-auth": "1.6.11",
		"close-with-grace": "2.5.0",
		"drizzle-orm": "0.45.2",
		"fastify": "5.8.5",
		"fastify-type-provider-zod": "6.1.0",
		"mysql2": "3.23.2",
		"nodemailer": "8.0.7",
		"pino": "10.3.1",
		"uuid": "14.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@faker-js/faker": "10.4.0",
		"@types/node": "25.8.0",
		"@types/nodemailer": "8.0.0",
		"drizzle-kit": "0.31.10",
		"pino-pretty": "13.1.3",
		"tsx": "4.21.0",
		"typescript": "6.0.3",
		"vite-plugin-tsconfig-paths": "1.4.1"
	}
}
