PORT=8080
API_VERSION=v1
LOG_LEVEL=info
NODE_ENV=production
API_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:3000,http://referral-tracking-web:3000
FRONTEND_URL=http://localhost:3000

# Database — AWS RDS (staging). Host resolves to a private VPC IP
# (10.0.4.205) — only reachable from inside that VPC (EC2/ECS/Lambda in the
# same VPC, or via VPN/bastion/peering). Not reachable from a local machine
# or local Docker container without one of those.
DATABASE_URL=mysql://admin:Password@mysql-test.cimslxgvmfe1.us-east-1.rds.amazonaws.com:3306/referral-tracking

# Better Auth — secrets below are freshly generated for this env, distinct
# from env/development's, so a dev-secret leak can't be replayed against
# staging sessions/cookies.
BETTER_AUTH_SECRET=uYF6mCloeR58sy8aQDHPMAlw1HtQHqbHKf9vMyeBBE/a6lM5fWNBtlHZw0lFM3ZBoj7SzMzYDxb4b0ZYZ4EG6w==

COOKIE_SECRET=juH0msQSAPBx3KZAZxpmOuLcav2zJn3eu+uG4OKkDpyL6W9Im1oqPfLusOF+NN/nyo8x1eHAOphzUmCdhkbl7A==

# Session (seconds) — 1 day cache/update-age, 7 day total lifetime
SESSION_COOKIE_CACHE_MAX_AGE=86400
SESSION_UPDATE_AGE=86400
SESSION_EXPIRES_IN=604800

# Rate Limiting
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60
