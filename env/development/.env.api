PORT=8080
API_VERSION=v1
LOG_LEVEL=debug
NODE_ENV=development
API_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:3000,http://referral-tracking-web:3000
FRONTEND_URL=http://referral-tracking-web:3000

# Database
DATABASE_URL=mysql://root:secret@referral-tracking-database:3306/referral-tracking

# Connection pool — a single connection is enough for local dev
DB_POOL_CONNECTION_LIMIT=1
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECT_TIMEOUT_MS=10000

# Better Auth
BETTER_AUTH_SECRET=jzXX9qFOk7IlZDzLoS52EaI+J9bUY3tWRiUn2PHt6mZJS4XBLh9Zvuq4I311CgHslaNAcHe7Oiylq/9NDPH3Q==

COOKIE_SECRET=2G0A1ytLfgEqQ8X6EU+UM0vIBYQQHGG+Li3QoaFSvXaruW9HTo0lnakMZY2Awk0iLY1BZzs9QAV9priNfxGLZA==

# Session (seconds) — 1 day cache/update-age, 7 day total lifetime; loosened for local dev
SESSION_COOKIE_CACHE_MAX_AGE=86400
SESSION_UPDATE_AGE=86400
SESSION_EXPIRES_IN=604800

# Rate Limiting
RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW=60

# Two-factor auth — seconds a user has to complete their second factor
TWO_FACTOR_COOKIE_MAX_AGE_SECONDS=600

# SMTP (Mailpit, dev-only — view sent mail at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@referral-tracking.local
